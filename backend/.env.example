# Server
PORT=5000
NODE_ENV=development

# MongoDB — use an Atlas cluster (replica set) so multi-document transactions work
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lms?retryWrites=true&w=majority

# Auth — use a long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=1d

# Frontend origin allowed by CORS (only needed if the frontend calls the API directly instead of via the Next.js proxy)
CLIENT_ORIGIN=http://localhost:3000


# Due-date ("due tomorrow") and overdue reminder job interval in minutes. 0 disables it.
REMINDER_INTERVAL_MINUTES=60
